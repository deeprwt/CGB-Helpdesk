# Copy to .env.local and fill in. Never commit real values.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in email links, incl. invitations → /update-password).
# Must also be listed in Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=

# Outgoing email (required: invitations cannot be delivered without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required: the SLA job (/api/sla/check) refuses to run without it.
# pg_cron must send it as "Authorization: Bearer <value>".
CRON_SECRET=

# AskMira connector (optional). At least 32 characters.
ASKMIRA_LINK_SECRET=
ASKMIRA_ALLOWED_ORIGINS=
